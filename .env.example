DATABASE_URL=postgresql://remindme:remindme@127.0.0.1:5441/remindme
PORT=3013
# Loopback by default; set HOST=0.0.0.0 only to expose the app directly.
HOST=127.0.0.1
# Reminder times are wall-clock times in this zone (DST handled).
HOUSEHOLD_TIMEZONE=America/New_York
# Tap-through link in each push (optional), e.g. https://home.example.ts.net/remind/
APP_PUBLIC_URL=
# brrr notification icon (iPhone/iPad). Must be publicly reachable, not a tailnet URL.
BRRR_ICON_URL=https://sovereignhome.org/images/apps/remind-me/icon-180.png
# Keep retrying a failed push for this many hours after it was due, then mark it failed (0.25-72).
DELIVERY_GIVE_UP_HOURS=12
# Finished reminders and their delivery history are kept this many days.
RETENTION_DAYS=180
# The web process also dispatches every minute, as a backstop to the systemd timer. Safe to run both.
IN_PROCESS_DISPATCH=true
# Apply pending migrations at startup (also run by `npm run db:migrate`).
MIGRATE_ON_START=true

# Sovereign font delivery (default: Google CDN; optional local override)
SOVEREIGN_FONT_SOURCE=google
SOVEREIGN_FONT_SANS_CSS_URL=https://fonts.googleapis.com/css2?family=Source+Sans+3:wght@400;500;600;700&display=swap
SOVEREIGN_FONT_MONO_CSS_URL=https://fonts.googleapis.com/css2?family=JetBrains+Mono:wght@400;500;600&display=swap
SOVEREIGN_FONT_SANS_CSS_URL_LOCAL=
SOVEREIGN_FONT_MONO_CSS_URL_LOCAL=
