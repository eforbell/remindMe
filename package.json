    "dispatch": "node scripts/dispatch.js",
    "test": "node --test --test-concurrency=1 \"test/*.test.js\""
  },
  "dependencies": {
    "dotenv": "^16.4.5",
    "express": "^4.21.2",
    "pg": "^8.13.1",
    "sovereign-auth": "github:eforbell/sovereignAuth#0f8bbe9cdab2adab46de0c6eaab33d06dad35c0f"
  }
}
