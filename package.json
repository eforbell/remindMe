{
  "name": "remind-me",
  "version": "1.0.0",
  "license": "MIT",
  "description": "Rugged household reminders: pick a time, pick people, they get a brrr.now push on the quarter hour.",
  "main": "server.js",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "start": "node server.js",
    "dev": "node --watch server.js",
